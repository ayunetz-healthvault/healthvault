# =============================================================================
# Ayunetz Health Vault — mobile client environment
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Only EXPO_PUBLIC_* variables are readable from the app bundle. Everything in
# this file therefore ships inside the APK/IPA and MUST be treated as PUBLIC.
#
# ---------------------------------------------------------------------------
# HARD RULE: no secrets here.
# ---------------------------------------------------------------------------
# The following must NEVER appear in this file, in `.env`, or anywhere in the
# mobile client. They live in AWS Secrets Manager and are used only by Lambda:
#   - OPENAI_API_KEY / any LLM provider key
#   - AWS_SECRET_ACCESS_KEY / AWS_ACCESS_KEY_ID
#   - Cognito app-client secrets  (use a PUBLIC client with PKCE instead)
#   - KMS key material, DynamoDB or S3 credentials, DB passwords
# The client calls API Gateway; API Gateway/Lambda calls the LLM. See README
# "Why the client never talks to OpenAI".
# =============================================================================

# --- Environment ------------------------------------------------------------
# local | dev | staging | prod
EXPO_PUBLIC_ENV=local

# When true the app runs entirely on in-memory mock data and mock services.
# This is what makes the MVP demoable with no backend at all.
EXPO_PUBLIC_USE_MOCKS=true

# --- AWS region (Mumbai — data residency for Indian health records) ----------
EXPO_PUBLIC_AWS_REGION=ap-south-1

# --- API Gateway ------------------------------------------------------------
# Regional REST/HTTP API endpoint fronting the Lambda handlers.
EXPO_PUBLIC_API_BASE_URL=https://api.dev.ayunetz.in
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# --- Amazon Cognito (public client, PKCE — no client secret) ----------------
EXPO_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_COGNITO_DOMAIN=ayunetz-dev.auth.ap-south-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_REDIRECT_URI=ayunetz://auth/callback

# --- S3 (documents) ---------------------------------------------------------
# Bucket name only. The client never holds S3 credentials: it asks the backend
# for a short-lived presigned PUT URL and uploads straight to S3.
EXPO_PUBLIC_S3_DOCUMENTS_BUCKET=ayunetz-documents-dev-ap-south-1
EXPO_PUBLIC_UPLOAD_PRESIGN_TTL_SECONDS=900
EXPO_PUBLIC_MAX_UPLOAD_MB=25

# --- Feature flags ----------------------------------------------------------
EXPO_PUBLIC_FEATURE_AI_SUMMARY=true
EXPO_PUBLIC_FEATURE_CALENDAR_SYNC=true
EXPO_PUBLIC_FEATURE_BIOMETRIC_LOCK=true

# --- Observability (optional) ----------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
