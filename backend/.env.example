# Ayunetz document-processing backend — development configuration.
#
# Copy to `.env`. Every value below has a working default, so an empty file
# still starts a usable service in mock mode.
#
# This file must never contain a real credential. `.env` is gitignored;
# `.env.example` is the only env file that is committed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- External AI provider ---------------------------------------------------
# LEAVE BLANK unless you intend to send text to Sarvam. An absent key selects
# the mock summary provider, which is what Phase 1 runs on by default.
#
# This key is backend-only. It must never appear in the Expo app, in an
# EXPO_PUBLIC_* variable, in app.json, or in anything that ships in an APK/IPA.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-30b
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Processing limits ------------------------------------------------------
# Temporary page images live here for the seconds it takes to OCR them, then are
# deleted in a finally block whether processing succeeded or failed.
PROCESSING_TEMP_DIR=
# 10 MB
MAX_PAGE_BYTES=10485760
MAX_DOCUMENT_PAGES=10
