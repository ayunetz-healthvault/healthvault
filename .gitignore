# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# backend build output (backend/node_modules is covered by node_modules/ above)
backend/dist/

# Tesseract language data, downloaded by tesseract.js on first OCR run.
# 5 MB of regenerable binary; see `cachePath` in TesseractOcrProvider.
*.traineddata

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env.example is the only env file that is committed
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# tests
coverage/

# local tooling settings
.claude/settings.local.json

# generated native folders
/ios
/android

# JetBrains IDE
.idea/
